# Copia este archivo como .env (no se sube a git) o define las variables en Vercel.
PORT=8080

# Supabase -> Project Settings -> Database -> Connection string -> JDBC (Transaction pooler, puerto 6543)
DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:6543/postgres?prepareThreshold=0&sslmode=require
DB_USER=postgres.<project-ref>
DB_PASSWORD=<contraseña de la base de datos>

# Clave para firmar los JWT (mínimo 32 caracteres aleatorios)
JWT_SECRET=<cadena-aleatoria-larga>

# Correo para el recordatorio de clave (ej. Gmail con "contraseña de aplicación")
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=<tu-correo@gmail.com>
MAIL_PASSWORD=<contraseña de aplicación>
MAIL_FROM=<tu-correo@gmail.com>
